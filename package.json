{
  "name": "squashables",
  "version": "0.0.0",
  "private": true,
  "description": "A GitHub App that enforces the merge strategy per pull request",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siketyan/squashables.git"
  },
  "type": "module",
  "scripts": {
    "check": "vp check",
    "test": "vp test",
    "codegen": "graphql-codegen --config codegen.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "prepare": "vp config"
  },
  "dependencies": {
    "@octokit/auth-app": "8.3.0",
    "@octokit/core": "7.0.7",
    "@octokit/plugin-rest-endpoint-methods": "18.0.0",
    "@octokit/plugin-retry": "8.1.1",
    "@octokit/plugin-throttling": "11.0.5",
    "valibot": "1.4.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.3.1",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.6",
    "@octokit/graphql-schema": "15.26.1",
    "@types/node": "26.3.0",
    "graphql": "16.14.2",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.126.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  }
}
